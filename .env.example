# Single env file for the backend and scripts/. Copy to .env and fill in.

# Required — Google AI Studio (free tier, no card): chat, embeddings, ticket summaries
GEMINI_API_KEY=

# Required — MongoDB Atlas free M0 cluster (Network Access must allow your IP)
MONGODB_URI=

# Optional — extra chat providers; each one appears in the UI's model picker once set
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Optional — backend port (default 3001) and a locked-down CORS origin
# (default: any http://localhost:<port>)
PORT=3001
FRONTEND_URL=
